# Не помещайте секреты в этот файл. Запуск без DATABASE_URL использует локальный PGlite.
HOST=
PORT=
ORIGIN=
DATA_DIR=
# Контакт администратора (mailto: или https:). При HTTPS по умолчанию используется ORIGIN.
VAPID_SUBJECT=
PUBLIC_DEMO=
USERS_FILE=
# Необязательный ключ для QR-входа. Сгенерируйте 32 случайных байта в hex.
QR_LOGIN_SECRET=
DATABASE_URL=
ORIGINAL_PATH=
ITSM_URL=
AI_TIMEOUT_MS=
# VseLLM читает ключ из файла DATA_DIR/secrets/vsellm.key или VSELLM_API_KEY окружения.
VSELLM_API_KEY_FILE=
VSELLM_MODEL=openai/gpt-4.1-mini
