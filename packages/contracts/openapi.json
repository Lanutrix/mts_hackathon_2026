{
  "openapi": "3.1.0",
  "info": {
    "title": "Срез API",
    "version": "0.1.0",
    "description": "Рабочие данные, учебный эфир и потоки событий требуют действующей сессии. Изменяющие запросы после входа используют CSRF-токен."
  },
  "security": [{ "session": [] }],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wm_session"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "RawIncident": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sysId": {
            "type": [
              "string",
              "null"
            ]
          },
          "stateId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "priorityId": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Revision": {
        "type": "integer",
        "minimum": 0
      },
      "Incident": {
        "type": "object",
        "required": [
          "key",
          "id",
          "raw",
          "revision",
          "groups",
          "sourcePresent"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "raw": {
            "$ref": "#/components/schemas/RawIncident"
          },
          "sourcePresent": {
            "type": "boolean"
          },
          "quarantined": {
            "type": "boolean"
          },
          "groups": {
            "type": "array",
            "items": {
              "enum": [
                "critical",
                "coordinators",
                "high",
                "research"
              ]
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/push/device/test": {
      "post": {
        "summary": "Проверить доставку на текущее подключённое устройство",
        "security": [{ "session": [], "csrf": [] }],
        "responses": { "200": { "description": "Проверка отправлена" }, "429": { "description": "Повторите позже" } }
      }
    },
    "/api/push/device": {
      "get": {
        "summary": "Настройки push этого устройства и публичный ключ VAPID",
        "responses": { "200": { "description": "Источники и состояние устройства" }, "401": { "description": "Требуется вход" } }
      },
      "post": {
        "summary": "Подключить устройство к уведомлениям выбранного источника",
        "security": [{ "session": [], "csrf": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["namespace", "subscription"], "properties": { "namespace": {"type": "string"}, "subscription": {"type":"object"}, "previousHash": {"type":"string"} } } } } },
        "responses": { "200": { "description": "Подписка сохранена" }, "409": { "description": "Подписка изменилась" } }
      },
      "delete": {
        "summary": "Отключить уведомления этого устройства",
        "security": [{ "session": [], "csrf": [] }],
        "responses": { "200": { "description": "Подписка отозвана" } }
      }
    },
    "/api/triage/{id}": {
      "parameters": [
        { "in":"path", "name":"id", "required":true, "schema":{"type":"string"} },
        { "in":"query", "name":"revision", "required":true, "schema":{"type":"integer"} },
        { "in":"query", "name":"hash", "required":true, "schema":{"type":"string"} }
      ],
      "get": {
        "summary": "Страница заявок выбранного кейса и версии",
        "description": "Повторите ns, groupBy, signal, q, service и up из запроса очереди.",
        "parameters": [
          {"in":"query","name":"offset","schema":{"type":"integer","minimum":0,"default":0}},
          {"in":"query","name":"limit","schema":{"type":"integer","minimum":1,"maximum":100,"default":30}},
          {"in":"query","name":"sort","schema":{"enum":["id","registered","deadline"]}}
        ],
        "responses": {
          "200":{"description":"revision, hash, total, offset, items и nextOffset"},
          "400":{"description":"Некорректные параметры запроса"},
          "401":{"description":"Для закрытого источника требуется вход"},
          "409":{"description":"Версия недоступна или хэш выборки не совпал"}
        }
      }
    },
    "/api/triage/{id}/analysis": {
      "parameters": [
        { "in":"path", "name":"id", "required":true, "schema":{"type":"string"} },
        { "in":"query", "name":"revision", "required":true, "schema":{"type":"integer"} },
        { "in":"query", "name":"hash", "required":true, "schema":{"type":"string"} }
      ],
      "post": {
        "summary": "Разбор кейса с привязкой к снимку и полям заявок",
        "requestBody": {"content":{"application/json":{"schema":{"type":"object","properties":{"question":{"type":"string","maxLength":500}}}}}},
        "description": "Фильтры и источник совпадают с запросом очереди. В учебных источниках разбор доступен вошедшим наблюдателям при включённой демонстрации. Для рабочих источников нужна роль coordinator или demo-admin. Запрос требует CSRF.",
        "responses": {
          "200":{"description":"Режим, модель, текст, цитаты с ID и полем, ограничения, хэш и версия"},
          "401":{"description":"Требуется вход"},
          "403":{"description":"Недостаточно прав или неверный источник запроса"},
          "409":{"description":"Версия недоступна или хэш выборки не совпал"},
          "429":{"description":"Достигнут лимит разборов"}
        }
      }
    },
