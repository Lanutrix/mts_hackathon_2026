{
  "openapi": "3.1.0",
  "info": {
    "title": "Watermelon API",
    "version": "0.1.0",
    "description": "Один источник истины: accepted file revision. Public read-only DEMO; cookie + CSRF для mutations."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wm_session"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "RawIncident": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sysId": {
            "type": [
              "string",
              "null"
            ]
          },
          "stateId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "priorityId": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Revision": {
        "type": "integer",
        "minimum": 0
      },
      "Incident": {
        "type": "object",
        "required": [
          "key",
          "id",
          "raw",
          "revision",
          "groups",
          "sourcePresent"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "raw": {
            "$ref": "#/components/schemas/RawIncident"
          },
          "sourcePresent": {
            "type": "boolean"
          },
          "quarantined": {
            "type": "boolean"
          },
          "groups": {
            "type": "array",
            "items": {
              "enum": [
                "critical",
                "coordinators",
                "high",
                "research"
              ]
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/public/focus": {
      "get": {
        "summary": "Один актуальный открытый сигнал из публичного демонстрационного источника",
        "responses": {
          "200": { "description": "tracking содержит id, header, revision и group или null" }
        }
      }
    },
    "/api/triage/{id}": {
      "parameters": [
        { "in":"path", "name":"id", "required":true, "schema":{"type":"string"} },
        { "in":"query", "name":"revision", "required":true, "schema":{"type":"integer"} },
        { "in":"query", "name":"hash", "required":true, "schema":{"type":"string"} }
      ],
      "get": {
        "summary": "Страница заявок выбранного кейса и версии",
        "description": "Повторите ns, groupBy, signal, q, service и up из запроса очереди.",
        "parameters": [
          {"in":"query","name":"offset","schema":{"type":"integer","minimum":0,"default":0}},
          {"in":"query","name":"limit","schema":{"type":"integer","minimum":1,"maximum":100,"default":30}},
          {"in":"query","name":"sort","schema":{"enum":["id","registered","deadline"]}}
        ],
        "responses": {
          "200":{"description":"revision, hash, total, offset, items и nextOffset"},
          "400":{"description":"Некорректные параметры запроса"},
          "401":{"description":"Для закрытого источника требуется вход"},
          "409":{"description":"Версия недоступна или хэш выборки не совпал"}
        }
      }
    },
    "/api/triage/{id}/analysis": {
      "parameters": [
        { "in":"path", "name":"id", "required":true, "schema":{"type":"string"} },
        { "in":"query", "name":"revision", "required":true, "schema":{"type":"integer"} },
        { "in":"query", "name":"hash", "required":true, "schema":{"type":"string"} }
      ],
      "post": {
        "summary": "Локальный экстрактивный разбор кейса по запросу",
        "description": "Фильтры и источник совпадают с запросом очереди. Публичный разбор разрешён для demo и simulation при включённой демонстрации. Остальные источники требуют роли координатора или demo-admin и CSRF.",
        "responses": {
          "200":{"description":"Режим, модель, текст, цитаты с ID и полем, ограничения, хэш и версия"},
          "401":{"description":"Требуется вход"},
          "403":{"description":"Недостаточно прав или неверный источник запроса"},
          "409":{"description":"Версия недоступна или хэш выборки не совпал"},
          "429":{"description":"Достигнут лимит разборов"}
        }
      }
    },
