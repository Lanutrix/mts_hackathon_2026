    "/api/incident/{id}/dispatch": {
      "parameters": [
        { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } },
        { "in": "query", "name": "ns", "schema": { "enum": ["demo", "workspace", "original", "simulation"], "default": "demo" } }
      ],
      "get": {
        "summary": "Команды из выгрузки и основания маршрутизации",
        "description": "Счётчики product, symptom и both отражают другие присутствующие обращения без критических ошибок в том же источнике. Каталог исполнителей и последние 20 локальных решений доступны координатору и demo-admin только в demo и workspace.",
        "responses": {
          "200": { "description": "snapshot, sourceRevision, incidentRevision, recommended (команда или null), product, symptom, teams, history, canSave, readOnlyReason. Элементы teams[].members содержат id, name, login, label, open и similar. open — число других открытых обращений этого сотрудника в команде (состояния 0, 2, 20). similar — число других обращений с теми же продуктом и симптомом независимо от состояния. Для предпросмотра сохраните snapshot и последнюю history[0].version или 0." },
          "401": { "description": "Для закрытого источника требуется вход" },
          "404": { "description": "Обращение или источник отсутствует" },
          "503": { "description": "Не удалось прочитать журнал" }
        }
      },
      "post": {
        "summary": "Записать решение координатора в журнал обращения",
        "description": "Роли coordinator и demo-admin, источники demo и workspace. Сохранение локальное. Повтор того же запроса с тем же requestId возвращает исходную запись.",
        "security": [{ "session": [], "csrf": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["requestId", "snapshot", "expectedVersion", "team", "member", "note"],
          "properties": {
            "requestId": { "type": "string", "format": "uuid" }, "snapshot": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "expectedVersion": { "type": "integer", "minimum": 0 }, "team": { "type": "string" },
            "member": { "type": ["string", "null"], "description": "id исполнителя из выбранной команды или null для назначения на группу" },
            "note": { "type": "string", "maxLength": 500 }
          }
        } } } },
        "responses": {
          "200": { "description": "decision с version, actor, at, team, member, note, incidentRevision, sourceRevision" },
          "400": { "description": "Поля запроса или получатель недопустимы" },
          "401": { "description": "Требуется вход" },
          "403": { "description": "Роль, источник или проверка CSRF запрещает запись" },
          "404": { "description": "Обращение отсутствует" },
          "409": { "description": "Снимок или решение изменились, обращение недоступно для назначения либо requestId повторно использован с иными данными" },
          "503": { "description": "Журнал временно недоступен" }
        }
      }
    },
